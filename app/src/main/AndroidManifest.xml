<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 13+ runtime notification permission is requested by MainActivity. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Exact-alarm special access may be required on Android 12 and later. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- User-granted special access lets the character appear above other apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Brief foreground service keeps the floating character visible reliably. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.MiniBF">

        <activity
            android:name=".BobbyChatActivity"
            android:exported="false" />

        <receiver
            android:name=".BobbyAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".BobbyTaskActionReceiver"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Short-lived overlay service, started only when a scheduled reminder fires. -->
        <service
            android:name=".FloatingReminderService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Display and speak a user-configured floating reminder character briefly when its alarm fires." />
        </service>

        <!-- Receives scheduled reminders. -->
        <receiver android:name=".ReminderReceiver" android:exported="false" />

        <!-- Restore scheduled alarms after reboot and clock/time-zone changes. -->
        <receiver android:name=".RescheduleReceiver" android:enabled="true" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
