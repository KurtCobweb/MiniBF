<?xml version="1.0" encoding="utf-8"?>
<!-- Add / edit a drink: choose gulps or mL, then type the amount. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <RadioGroup
        android:id="@+id/waterUnitGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/waterUnitGulps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Gulps" />

        <RadioButton
            android:id="@+id/waterUnitMl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="mL" />
    </RadioGroup>

    <EditText
        android:id="@+id/waterAmountInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Amount"
        android:importantForAutofill="no"
        android:inputType="number"
        android:maxLength="5" />

    <TextView
        android:id="@+id/waterAmountHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/pixel_secondary_text"
        android:textSize="12sp" />
</LinearLayout>
