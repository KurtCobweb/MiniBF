<?xml version="1.0" encoding="utf-8"?>
<!--
  One independently configurable reminder slot.
  A slot is identified by a stable unique ID in the app data model.
  Store time as hour (0..23) + minute (0..59), not as a formatted string.
  Store repeat days as a weekday bitmask or a list of ISO weekday numbers.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/slotTimeText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="08:00"
            android:textColor="@color/pixel_ink"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/editSlotTimeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/change_time"
            android:textAllCaps="false" />

        <Switch
            android:id="@+id/slotEnabledSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/slot_enabled_description"
            android:checked="true" />
    </LinearLayout>

    <!-- Kotlin opens a weekday selector and writes the selected days here. -->
    <TextView
        android:id="@+id/slotRepeatDaysText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/default_repeat_days"
        android:textColor="@color/pixel_secondary_text"
        android:textSize="12sp" />

    <Button
        android:id="@+id/deleteSlotButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:text="@string/delete_slot"
        android:textAllCaps="false" />
</LinearLayout>
