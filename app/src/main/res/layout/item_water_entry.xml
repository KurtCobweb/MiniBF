<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/waterEntryText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="monospace"
        android:textColor="@color/pixel_ink"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/waterGulpMinus"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="−"
        android:textSize="20sp"
        android:contentDescription="Subtract one gulp" />

    <Button
        android:id="@+id/waterGulpPlus"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="+"
        android:textSize="20sp"
        android:contentDescription="Add one gulp" />

    <Button
        android:id="@+id/waterEntryDelete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:text="Delete"
        android:textAllCaps="false" />
</LinearLayout>
